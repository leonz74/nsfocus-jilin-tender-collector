{
  "start_date": "2026-01-01",
  "end_date": "2026-08-21",
  "output_dir": "output",
  "database": "output/state.sqlite3",
  "http": {
    "timeout_seconds": 35,
    "delay_seconds": 5.0,
    "max_retries": 2,
    "max_response_mb": 25,
    "max_download_mb": 1024,
    "download_timeout_seconds": 900,
    "allow_private_hosts": false,
    "allow_benchmark_proxy_hosts": false
  },
  "sources": [
    {
      "type": "jilin_ggzy",
      "enabled": true,
      "authority_rank": 100,
      "page_size": 100,
      "max_pages_per_channel": 300
    },
    {
      "type": "ccgp_search",
      "enabled": true,
      "authority_rank": 95,
      "window_days": 31,
      "max_pages_per_query": 100
    },
    {
      "type": "ccgp_archive",
      "enabled": true,
      "authority_rank": 90,
      "scopes": ["zygg", "dfgg"],
      "categories": ["gkzb", "jzxcs", "jzxtpgg", "xjgg", "dylygg", "zbgg", "cjgg", "gzgg", "fbgg"],
      "max_pages_per_category": 500
    },
    {
      "type": "national_ggzy",
      "enabled": true,
      "authority_rank": 65,
      "source_types": ["1", "3"],
      "deal_types": ["01", "02"],
      "window_days": 14,
      "max_pages_per_window": 50
    },
    {
      "type": "custom_web",
      "adapter": "okcis",
      "name": "招标采购导航网（OKCIS）",
      "id": "okcis",
      "enabled": false,
      "authority_rank": 40,
      "source_role": "commercial_lead",
      "start_urls": ["https://www.okcis.cn/search/"],
      "max_pages": 100,
      "auth": {
        "mode": "browser",
        "login_url": "https://www.okcis.cn/login/",
        "check_url": "https://www.okcis.cn/search/"
      }
    },
    {
      "type": "url_seed",
      "enabled": false,
      "authority_rank": 80,
      "path": "official_urls.csv"
    }
  ],
  "ai": {
    "enabled": false,
    "provider": "custom",
    "protocol": "openai_compatible",
    "endpoint": "https://your-model-provider.example/v1/chat/completions",
    "model": "replace-with-model-name",
    "api_key_env": "TENDER_AI_API_KEY",
    "auto_accept_threshold": 0.85,
    "second_review_threshold": 0.60,
    "reclassify": false,
    "timeout_seconds": 60
  },
  "recall": {
    "mode": "p0_complete"
  },
  "provenance": {
    "max_gate_file_mb": 256,
    "allow_registered_http_fallback": false
  },
  "delivery": {
    "mode": "on_demand",
    "include_notice_html_when_no_attachment": true,
    "include_official_notice_with_attachments": true,
    "copy_uncertain_to_review": true
  }
}
